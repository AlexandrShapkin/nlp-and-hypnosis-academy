{
  "name": "nlp-and-hypnosis-academy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 8080",
    "start": "next start --hostname 127.0.0.1 --port 8080",
    "build": "next build --webpack",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/db.ts migrate",
    "db:seed": "tsx scripts/db.ts seed",
    "admin:bootstrap": "tsx scripts/db.ts bootstrap",
    "format:check": "prettier --check src scripts tests *.ts *.mjs *.json",
    "format": "prettier --write src scripts tests *.ts *.mjs *.json",
    "test:cms": "node scripts/test-cms-isolated.mjs",
    "test:worker": "python3 -m unittest discover -s tests -p opencode_wrapper_test.py"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "next": "16.4.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "25.3.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "prettier": "3.8.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": false,
    "esbuild@0.27.7": true,
    "sharp@0.35.5": false
  },
  "engines": {
    "node": ">=22"
  }
}
