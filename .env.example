# Copy to .env.local after Codex implements application config.
# Do not commit .env.local.
NODE_ENV=development
PORT=8080
HOSTNAME=127.0.0.1
SITE_URL=http://localhost:8080
SITE_LOCALE=ru-RU
DATABASE_URL=file:./data/site.sqlite
SEO_ALLOW_INDEXING=false
# Generate a unique secret outside version control. Never commit actual values.
SESSION_SECRET=
# One-time bootstrap command should prompt securely for the first admin password.
ADMIN_BOOTSTRAP_EMAIL=
# Optional external booking URL configured by the maintainer in admin UI.
# Private one-time bootstrap password (at least 14 characters); remove after use.
ADMIN_BOOTSTRAP_PASSWORD=
# Enable only behind a trusted proxy that overwrites incoming X-Forwarded-For.
TRUST_PROXY=false
